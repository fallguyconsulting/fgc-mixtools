+static std::string
+handle_session_import_audio_tool (ARDOUR::Session& session, const pt::ptree& root, const std::string& id)
+{
+	std::vector<std::string> paths;
+	std::vector<std::string> track_names;
+
+	if (boost::optional<const pt::ptree&> p = root.get_child_optional ("params.arguments.paths")) {
+		for (pt::ptree::value_type const& v : *p) {
+			paths.push_back (v.second.get_value<std::string> ());
+		}
+	}
+	if (boost::optional<const pt::ptree&> n = root.get_child_optional ("params.arguments.trackNames")) {
+		for (pt::ptree::value_type const& v : *n) {
+			track_names.push_back (v.second.get_value<std::string> ());
+		}
+	}
+	if (paths.empty ()) {
+		return jsonrpc_error (id, -32602, "paths must be a non-empty array of absolute audio file paths");
+	}
+	for (std::string const& path : paths) {
+		if (!g_path_is_absolute (path.c_str ()) || !g_file_test (path.c_str (), G_FILE_TEST_IS_REGULAR)) {
+			return jsonrpc_error (id, -32602, std::string ("Not an absolute path to an existing file: ") + path);
+		}
+	}
+
+	const int64_t position_sample = root.get<int64_t> ("params.arguments.positionSample", 0);
+	if (position_sample < 0) {
+		return jsonrpc_error (id, -32602, "positionSample must be >= 0");
+	}
+	const Temporal::timepos_t pos ((samplepos_t)position_sample);
+
+	/* Session::import_files() and region creation use the calling thread's tempo map. */
+	Temporal::TempoMap::fetch ();
+	ARDOUR::Session::StateProtector sp (&session);
+
+	uint32_t out_chans = 2;
+	if (session.master_out ()) {
+		out_chans = std::max<uint32_t> (1, session.master_out ()->n_inputs ().n_audio ());
+	}
+
+	std::ostringstream imported;
+	imported << "[";
+
+	for (size_t i = 0; i < paths.size (); ++i) {
+		std::string const& path = paths[i];
+
+		/* Copy the file into the session, converting to the session's sample rate,
+		 * the same way the editor's import dialog does.
+		 */
+		ARDOUR::ImportStatus status;
+		status.paths.push_back (path);
+		status.quality                 = ARDOUR::SrcBest;
+		status.replace_existing_source = false;
+		status.split_midi_channels     = false;
+		status.import_markers          = false;
+		status.midi_track_name_source  = ARDOUR::SMFTrackNumber;
+		status.freeze                  = false;
+		status.done                    = false;
+		status.cancel                  = false;
+		status.current                 = 1;
+		status.total                   = 1;
+
+		session.import_files (status);
+
+		ARDOUR::SourceList sources;
+		for (std::shared_ptr<ARDOUR::Source> const& s : status.sources) {
+			if (s && !s->empty ()) {
+				sources.push_back (s);
+			}
+		}
+		if (status.cancel || sources.empty ()) {
+			return jsonrpc_error (id, -32000, std::string ("Import failed: ") + path);
+		}
+		if (sources.front ()->type () != ARDOUR::DataType::AUDIO) {
+			return jsonrpc_error (id, -32602, std::string ("Not an audio file: ") + path);
+		}
+
+		const std::string name = (i < track_names.size () && !track_names[i].empty ())
+		                             ? track_names[i]
+		                             : std::string (PBD::basename_nosuffix (path));
+
+		PBD::PropertyList plist;
+		plist.add (ARDOUR::Properties::start, Temporal::timecnt_t (Temporal::AudioTime));
+		plist.add (ARDOUR::Properties::length, sources.front ()->length ());
+		plist.add (ARDOUR::Properties::name, name);
+		plist.add (ARDOUR::Properties::layer, 0);
+		plist.add (ARDOUR::Properties::whole_file, true);
+		plist.add (ARDOUR::Properties::external, true);
+		plist.add (ARDOUR::Properties::opaque, true);
+
+		std::shared_ptr<ARDOUR::Region> whole = ARDOUR::RegionFactory::create (sources, plist);
+
+		std::list<std::shared_ptr<ARDOUR::AudioTrack>> tracks = session.new_audio_track (
+		    (int)sources.size (),
+		    (int)out_chans,
+		    std::shared_ptr<ARDOUR::RouteGroup> (),
+		    1,
+		    name,
+		    ARDOUR::PresentationInfo::max_order,
+		    ARDOUR::Normal,
+		    true,
+		    false);
+		if (tracks.empty () || !tracks.front ()) {
+			return jsonrpc_error (id, -32000, std::string ("Could not create a track for: ") + path);
+		}
+		std::shared_ptr<ARDOUR::AudioTrack> track = tracks.front ();
+
+		std::shared_ptr<ARDOUR::Playlist> playlist = track->playlist ();
+		std::shared_ptr<ARDOUR::Region>   region   = ARDOUR::RegionFactory::create (whole, whole->derive_properties ());
+		playlist->clear_changes ();
+		playlist->clear_owned_changes ();
+		playlist->add_region (region, pos);
+
+		/* Export renders the session range, so it must cover the new material. */
+		session.maybe_update_session_range (region->position (), region->end_position ());
+
+		imported << (i ? "," : "")
+		         << "{\"path\":\"" << json_escape (path) << "\""
+		         << ",\"trackId\":\"" << json_escape (track->id ().to_s ()) << "\""
+		         << ",\"trackName\":\"" << json_escape (track->name ()) << "\""
+		         << ",\"regionName\":\"" << json_escape (region->name ()) << "\""
+		         << ",\"channels\":" << sources.size ()
+		         << ",\"positionSample\":" << region->position ().samples ()
+		         << ",\"lengthSamples\":" << region->length ().samples ()
+		         << "}";
+	}
+
+	imported << "]";
+
+	std::ostringstream structured;
+	structured << "{\"imported\":" << imported.str ()
+	           << ",\"session\":" << session_info_json (session)
+	           << "}";
+
+	return jsonrpc_result (
+	    id,
+	    std::string ("{\"content\":[{\"type\":\"text\",\"text\":\"Audio imported\"}],\"structuredContent\":") + structured.str () + "}");
+}
+
 static bool
 dispatch_session_tool_call (ARDOUR::Session& session, const std::string& tool_name, const pt::ptree& root, const std::string& id, std::string& response)
 {
+	if (tool_name == "session/import_audio") {
+		response = handle_session_import_audio_tool (session, root, id);
+		return true;
+	}
 	if (tool_name == "session/get_info") {
 		response = handle_session_get_info_tool (session, id);
 		return true;
